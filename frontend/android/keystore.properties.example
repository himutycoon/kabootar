# Copy this file to keystore.properties (same folder) and fill in your real values.
# keystore.properties is git-ignored. NEVER commit it or your keystore.
# Use forward slashes in the path.
storeFile=C:/path/to/your-upload-keystore.jks
# pkcs12 for modern keystores (or files without a .jks extension), jks for old ones
storeType=pkcs12
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
